# Copy to .env on the EC2 host. Never commit real credentials.
# Publish through the existing FinSight CI workflow first.
FINSIGHT_IMAGE=ghcr.io/OWNER/REPOSITORY:sha-FULL_COMMIT_SHA
# Choose a tested official Ollama tag or digest before deployment.
OLLAMA_IMAGE=ollama/ollama:REPLACE_WITH_TESTED_VERSION
SEC_USER_AGENT=FinSight your-contact@example.com
# Not required for the UI startup check; required for real research.
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
